# Copie para .env (o .env NÃO vai para o git).
RABBITMQ_USER=dm
RABBITMQ_PASSWORD=troque-esta-senha
# Acesso local por http://localhost: cookie sem a flag Secure.
# Em produção com HTTPS, use true.
DM_COOKIE_SECURE=false
DM_LOG_JSON=true

# Rate limit por IP em /api/* (requisições por janela; 0 desliga a regra)
DM_RATE_LIMIT_READS_PER_MINUTE=600
DM_RATE_LIMIT_WRITES_PER_MINUTE=120
DM_RATE_LIMIT_REGISTERS_PER_HOUR=5
DM_RATE_LIMIT_EXPORTS_PER_MINUTE=5
