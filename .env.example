# Copie para .env (o .env NÃO vai para o git).
RABBITMQ_USER=dm
RABBITMQ_PASSWORD=troque-esta-senha
# Acesso local por http://localhost: cookie sem a flag Secure.
# Em produção com HTTPS, use true (e opcionalmente DM_COOKIE_NAME=__Host-dm_session).
DM_COOKIE_SECURE=false
# Documentação interativa (/docs, /openapi.json): deixe false em produção.
DM_ENABLE_DOCS=false
# IPs confiáveis do proxy reverso que envia X-Forwarded-For (nunca use '*' exposto à internet).
FORWARDED_ALLOW_IPS=127.0.0.1
DM_LOG_JSON=true

# Rate limit por IP em /api/* (requisições por janela; 0 desliga a regra)
DM_RATE_LIMIT_READS_PER_MINUTE=600
DM_RATE_LIMIT_WRITES_PER_MINUTE=120
DM_RATE_LIMIT_REGISTERS_PER_HOUR=5
DM_RATE_LIMIT_EXPORTS_PER_MINUTE=5
DM_RATE_LIMIT_SENSITIVE_PER_MINUTE=10

# E-mails com acesso à área /admin, separados por vírgula (vazio = ninguém é admin).
# Cadastre a conta ANTES de pôr o e-mail aqui: quem cadastrar um e-mail admin livre vira admin.
# Um e-mail inválido impede o serviço de subir.
DM_ADMIN_EMAILS=
